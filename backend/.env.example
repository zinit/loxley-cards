# Template for backend/.env (which is .gitignored)
# Copy this file to backend/.env and replace placeholders with real values.

# Supabase PostgreSQL via pgbouncer (transaction-mode pooler, port 6543)
# Region: eu-central-1 (Frankfurt)
# Format: JDBC (with "jdbc:" prefix), NOT URI from Supabase dashboard "URI" tab.
# Get connection string: Supabase dashboard → Project Settings → Database → Connection string → JDBC tab (Transaction pooler).
#
# Credentials SPLIT into three variables on purpose: when password is embedded in
# the JDBC URL query string (e.g. ?user=X&password=Y), Hibernate's connection-pool
# printer logs the full URL incl. password at INFO on startup. Splitting them lets
# Hikari mask the password ("password=********") in all logs.

DATABASE_URL=jdbc:postgresql://aws-1-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_USERNAME=postgres.<PROJECT_REF>
DATABASE_PASSWORD=<DB_PASSWORD>

# JWT signing secret for session tokens (HTTPOnly cookie).
# Generate with: openssl rand -base64 48
# Must be 32+ random bytes. Rotation: change value + restart app → all sessions invalidated.
JWT_SECRET=<generate with: openssl rand -base64 48>
