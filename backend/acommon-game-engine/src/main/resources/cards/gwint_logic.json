{
  "schemaVersion": "0.1",
  "ruleset": {
    "id": "gwent_reference_mvp",
    "name": "Gwent Reference MVP",
    "description": "Referencyjny zestaw kart i efektów do szybkiego POC silnika gry karcianej inspirowanej Gwintem z Wiedźmina 3.",
    "matchFormat": {
      "roundsToWin": 2,
      "maxRounds": 3,
      "startingHandSize": 10,
      "drawEachTurn": false,
      "actionPerTurn": 1,
      "allowedActions": ["PLAY_CARD", "PASS", "USE_LEADER"]
    }
  },
  "rows": [
    {
      "code": "I",
      "id": "CLOSE",
      "originalName": "Close Combat",
      "polishName": "Zwarcie",
      "description": "Rząd dla jednostek walczących wręcz."
    },
    {
      "code": "II",
      "id": "RANGED",
      "originalName": "Ranged Combat",
      "polishName": "Dystans",
      "description": "Rząd dla jednostek dystansowych."
    },
    {
      "code": "III",
      "id": "SIEGE",
      "originalName": "Siege Combat",
      "polishName": "Oblężenie",
      "description": "Rząd dla jednostek oblężniczych."
    }
  ],
  "abilities": [
    {
      "code": "HERO",
      "originalName": "Hero",
      "polishName": "Bohater",
      "type": "PASSIVE",
      "target": "SELF",
      "description": "Karta odporna na pogodę, karty specjalne i większość efektów innych kart.",
      "implementationNotes": "Efekty pogodowe, Scorch, Decoy, Medic i Commander's Horn nie powinny zmieniać tej karty, chyba że jawnie dopuszczasz wyjątek."
    },
    {
      "code": "SPY",
      "originalName": "Spy",
      "polishName": "Szpieg",
      "type": "ON_PLAY",
      "target": "OPPONENT_BOARD",
      "description": "Karta jest zagrywana na stronę przeciwnika. Przeciwnik dostaje jej punkty, a właściciel karty dobiera 2 karty.",
      "implementationNotes": "Po zagraniu karta trafia do rzędu przeciwnika, ale efekt dobierania kart wykonuje gracz, który ją zagrał."
    },
    {
      "code": "MEDIC",
      "originalName": "Medic",
      "polishName": "Medyk / Zmartwychwstanie",
      "type": "ON_PLAY",
      "target": "OWN_DISCARD",
      "description": "Pozwala wybrać jednostkę z własnego stosu kart odrzuconych i natychmiast ją zagrać.",
      "implementationNotes": "Nie pozwalaj przywracać kart specjalnych ani kart HERO, jeśli trzymasz się klasycznego modelu."
    },
    {
      "code": "TIGHT_BOND",
      "originalName": "Tight Bond",
      "polishName": "Więź",
      "type": "SCORING_MODIFIER",
      "target": "SAME_CARD_IN_ROW",
      "description": "Karty o tej samej nazwie w tym samym rzędzie wzmacniają się wzajemnie.",
      "implementationNotes": "Najprościej: jeśli w rzędzie jest więcej niż jedna kopia tej samej karty z TIGHT_BOND, każda z nich ma podwojoną bazową siłę."
    },
    {
      "code": "MORALE_BOOST",
      "originalName": "Morale Boost",
      "polishName": "Wysokie morale",
      "type": "SCORING_MODIFIER",
      "target": "OTHER_UNITS_IN_SAME_ROW",
      "description": "Dodaje +1 siły innym jednostkom w tym samym rzędzie.",
      "implementationNotes": "Efekt nie powinien wzmacniać samej karty, która ma MORALE_BOOST."
    },
    {
      "code": "COMMANDERS_HORN",
      "originalName": "Commander's Horn",
      "polishName": "Róg dowódcy",
      "type": "SPECIAL",
      "target": "SELECTED_ROW",
      "description": "Podwaja siłę wszystkich zwykłych jednostek w wybranym rzędzie.",
      "implementationNotes": "Nie powinien wpływać na karty HERO. W rzędzie powinien działać tylko jeden aktywny efekt tego typu."
    },
    {
      "code": "SCORCH",
      "originalName": "Scorch",
      "polishName": "Pożoga",
      "type": "SPECIAL",
      "target": "BOARD_MAX_POWER_UNITS",
      "description": "Niszczy najmocniejsze jednostki na planszy.",
      "implementationNotes": "W klasycznym wariancie usuwa wszystkie niebohaterskie jednostki z najwyższą aktualną siłą."
    },
    {
      "code": "DECOY",
      "originalName": "Decoy",
      "polishName": "Manekin",
      "type": "SPECIAL",
      "target": "OWN_UNIT_ON_BOARD",
      "description": "Pozwala zabrać własną jednostkę ze stołu z powrotem do ręki.",
      "implementationNotes": "Najlepsze użycie: cofnięcie szpiega, medyka albo mocnej karty efektowej. Nie powinien działać na HERO."
    },
    {
      "code": "WEATHER_CLOSE",
      "originalName": "Biting Frost",
      "polishName": "Trzaskający mróz",
      "type": "WEATHER",
      "target": "CLOSE_ROW_BOTH_PLAYERS",
      "description": "Ustawia siłę wszystkich zwykłych jednostek w rzędzie zwarcia obu graczy na 1.",
      "implementationNotes": "Nie wpływa na HERO. Pogoda działa symetrycznie na obu graczy."
    },
    {
      "code": "WEATHER_RANGED",
      "originalName": "Impenetrable Fog",
      "polishName": "Gęsta mgła",
      "type": "WEATHER",
      "target": "RANGED_ROW_BOTH_PLAYERS",
      "description": "Ustawia siłę wszystkich zwykłych jednostek dystansowych obu graczy na 1.",
      "implementationNotes": "Nie wpływa na HERO. Pogoda działa symetrycznie na obu graczy."
    },
    {
      "code": "WEATHER_SIEGE",
      "originalName": "Torrential Rain",
      "polishName": "Ulewny deszcz",
      "type": "WEATHER",
      "target": "SIEGE_ROW_BOTH_PLAYERS",
      "description": "Ustawia siłę wszystkich zwykłych jednostek oblężniczych obu graczy na 1.",
      "implementationNotes": "Nie wpływa na HERO. Pogoda działa symetrycznie na obu graczy."
    },
    {
      "code": "CLEAR_WEATHER",
      "originalName": "Clear Weather",
      "polishName": "Czyste niebo",
      "type": "SPECIAL",
      "target": "ALL_WEATHER_EFFECTS",
      "description": "Usuwa wszystkie aktywne efekty pogodowe.",
      "implementationNotes": "Po usunięciu pogody należy przeliczyć siłę rzędów."
    }
  ],
