<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/>
	</parent>

	<groupId>cards.loxley</groupId>
	<artifactId>loxley-cards-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>Loxley Cards - Parent</name>
	<description>Multi-module parent POM for the Loxley Cards backend</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<modules>
		<module>acommon-game-engine</module>
		<module>acommon-game-cli</module>
		<module>acommon-db</module>
		<module>acommon-ai</module>
		<module>app</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>cards.loxley</groupId>
				<artifactId>loxley-cards-game-engine</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>cards.loxley</groupId>
				<artifactId>loxley-cards-game-cli</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>cards.loxley</groupId>
				<artifactId>loxley-cards-db</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>cards.loxley</groupId>
				<artifactId>loxley-cards-ai</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
